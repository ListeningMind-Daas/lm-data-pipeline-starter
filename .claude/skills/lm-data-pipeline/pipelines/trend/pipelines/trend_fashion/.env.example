# trend_fashion 수집/파이프라인 환경변수. 실제 값은 .env(gitignore)에 두고 export 후 실행:
#   set -a; source .env; set +a
#   python3 lm_api.py --check          # API 연결 검증
#   python3 run_all.py                 # 빌드 체인(05~08)

# ── ListeningMind DaaS Data API (데이터 추출 — API Key 직접 호출) ──────
# 라이브 스펙: https://listeningmind-data-api.ascentlab.io/openapi.json (LM-API-KEY 헤더 인증)
# ⚠️ 구 SaaS API Key는 서비스 종료 — DaaS Data API 권한(계약) 필요.
LM_API_KEY=                                          # DaaS 발급 API 키 (커밋 금지)
LM_API_BASE=https://listeningmind-data-api.ascentlab.io
LM_API_TIMEOUT=60

# ── 런 식별 (신규 런/시장은 이 3개만 변경) ───────────────────
TREND_FASHION_GL=kr                                  # kr | jp | us
TREND_FASHION_CATEGORY=trend_fashion
TREND_FASHION_RUN_DATE=2026-07-22                    # 런 스냅샷 날짜 → RUN_ID
